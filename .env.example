# Copy to .env (untracked) or export in your shell. Nothing here is required for
# the offline quickstart: `make check` and `make demo` run with no keys.
#
# A key alone never enables paid calls. Paid commands also need --allow-paid and
# limits from config/budgets.yaml (unattended) or your approval (interactive).

# Anthropic API key (paid calls; Phase 1+)
ANTHROPIC_API_KEY=

# Tracing backend: none | local | langfuse  (default: none)
TRACING_BACKEND=none

# Langfuse Cloud (optional; only for TRACING_BACKEND=langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
